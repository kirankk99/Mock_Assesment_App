# MongoDB connection string.
# For Netlify deployment you MUST use MongoDB Atlas (a free M0 cluster is fine)
# since Netlify's serverless functions cannot reach a database on your laptop.
MONGODB_URI="mongodb://<your code>"

# Auth (Phase 1 — multi-tenant foundation)
JWT_SECRET="<generate a long random string>"
SESSION_TTL_SECONDS="604800"

# Super Admin bootstrap (npm run bootstrap:super-admin) — no self-registration
# path exists for this role, only Org Admins register themselves.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD="<set a strong password>"

